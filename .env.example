# TruthCheck environment configuration
PORT=5000

# Google Gemini API Key (Recommended - Primary Fast Fact-Checker)
# Get a free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter Configuration (Optional fallback for Fact-Checking AI)
# Free key from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

